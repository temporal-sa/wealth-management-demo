{
  "extends": "@tsconfig/node20/tsconfig.json",
  "version": "5.6.3",
  "compilerOptions": {
    "lib": [
      "es2021"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "./lib",
    "types": [
      "node",
      "mocha"
    ]
  },
  "include": [
    "common/**/*.ts",
    "vercel_ai/**/*.ts",
    "google_adk/**/*.ts",
    "strands_agents/**/*.ts",
    "openai_agents/**/*.ts"
  ]
}
